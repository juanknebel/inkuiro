<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed state = inversion (black background); normal = 2dp border. No grays. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_black" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_white" />
            <stroke android:width="2dp" android:color="@color/ink_black" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
