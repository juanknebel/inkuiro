<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/back_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/settings"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Widget.InkChat.Label"
                android:text="@string/provider_label" />

            <TextView
                android:id="@+id/txtProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_black"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnChangeProvider"
                style="@style/Widget.InkChat.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/change_provider" />

            <TextView
                android:id="@+id/baseUrlLabel"
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="20dp"
                android:text="@string/base_url_label"
                android:visibility="gone" />

            <EditText
                android:id="@+id/inputBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:cursorVisible="false"
                android:hint="@string/base_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/ink_black"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="20dp"
                android:text="@string/api_key_label" />

            <TextView
                android:id="@+id/txtKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/inputApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:cursorVisible="false"
                android:hint="@string/api_key_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/ink_black"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTestConnection"
                    style="@style/Widget.InkChat.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_connection" />

                <Button
                    android:id="@+id/btnDeleteKey"
                    style="@style/Widget.InkChat.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/delete_key"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="20dp"
                android:text="@string/default_model_label" />

            <TextView
                android:id="@+id/txtDefaultModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_black"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnChooseModel"
                style="@style/Widget.InkChat.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/choose_model" />

            <TextView
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="20dp"
                android:text="@string/system_prompt_label" />

            <EditText
                android:id="@+id/inputSystemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:cursorVisible="false"
                android:gravity="top"
                android:hint="@string/system_prompt_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:maxLines="8"
                android:padding="12dp"
                android:textColor="@color/ink_black"
                android:textSize="16sp" />

            <TextView
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="20dp"
                android:text="@string/temperature_label" />

            <EditText
                android:id="@+id/inputTemperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:cursorVisible="false"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/ink_black"
                android:textSize="16sp" />

            <TextView
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="20dp"
                android:text="@string/max_tokens_label" />

            <EditText
                android:id="@+id/inputMaxTokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:cursorVisible="false"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/ink_black"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnAbout"
                style="@style/Widget.InkChat.Button.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical|start"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/about"
                android:textSize="18sp" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <!-- Always visible: results of Save / Test connection land here -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/ink_black"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSave"
        style="@style/Widget.InkChat.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="@string/save" />
</LinearLayout>
