<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/back_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/about_title"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/ink_black"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink_black"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/about_tagline"
                android:textColor="@color/ink_black"
                android:textSize="17sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/ink_black" />

            <TextView
                style="@style/Widget.InkChat.Label"
                android:text="@string/about_author_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/author_name"
                android:textColor="@color/ink_black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_flat"
                android:minHeight="44dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/author_email"
                android:textColor="@color/ink_black"
                android:textSize="18sp" />

            <TextView
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="24dp"
                android:text="@string/about_repo_label" />

            <TextView
                android:id="@+id/txtRepo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_button_flat"
                android:minHeight="44dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/author_repo"
                android:textColor="@color/ink_black"
                android:textSize="18sp" />

            <TextView
                style="@style/Widget.InkChat.Label"
                android:layout_marginTop="24dp"
                android:text="@string/about_license_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/about_license_value"
                android:textColor="@color/ink_black"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
