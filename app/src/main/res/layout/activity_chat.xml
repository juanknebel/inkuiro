<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/back_arrow" />

        <LinearLayout
            android:id="@+id/headerInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink_black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink_black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink_black"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPageUp"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/page_up" />

        <Button
            android:id="@+id/btnPageDown"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/page_down" />

        <Button
            android:id="@+id/btnMore"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/more_actions"
            android:text="@string/more_glyph"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <dev.zero.inkchat.ui.chat.PagedScrollView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </dev.zero.inkchat.ui.chat.PagedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <TextView
        android:id="@+id/errorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_banner"
        android:lineSpacingMultiplier="1.4"
        android:padding="12dp"
        android:textColor="@color/ink_black"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRetry"
        style="@style/Widget.InkChat.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/retry"
        android:visibility="gone" />

    <TextView
        android:id="@+id/generatingLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:text="@string/generating"
        android:textColor="@color/ink_black"
        android:textSize="14sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/attachmentPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgAttachmentPreview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/attached_image"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btnRemoveAttachment"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/remove_attachment"
            android:text="@string/remove_glyph" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnAttach"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/attach_image"
            android:text="@string/attach_glyph" />

        <Button
            android:id="@+id/btnWebSearch"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/web_search_toggle"
            android:text="@string/web_search_glyph"
            android:visibility="gone" />

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:cursorVisible="false"
            android:hint="@string/message_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/ink_black"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSend"
            style="@style/Widget.InkChat.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/send" />
    </LinearLayout>
</LinearLayout>
