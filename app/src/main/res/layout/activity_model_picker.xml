<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/back_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/pick_model_title"
            android:textColor="@color/ink_black"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <EditText
        android:id="@+id/inputSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_input"
        android:cursorVisible="false"
        android:hint="@string/search_models_hint"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/ink_black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtPickerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/ink_black"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRetryModels"
        style="@style/Widget.InkChat.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/retry"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/modelsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider_line"
            android:orientation="vertical"
            android:showDividers="middle|end" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnPrevPage"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/page_prev" />

        <TextView
            android:id="@+id/lblPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/ink_black"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnNextPage"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/page_next" />
    </LinearLayout>
</LinearLayout>
