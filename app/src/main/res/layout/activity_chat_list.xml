<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/app_name"
            android:textColor="@color/ink_black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNewConversation"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/new_conversation"
            android:text="@string/plus_sign"
            android:textSize="28sp" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/settings"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ink_black" />

    <!-- Default provider for new conversations (per-conversation switch lives in chat). -->
    <Button
        android:id="@+id/btnProvider"
        style="@style/Widget.InkChat.Button.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|start"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ink_black" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_input"
        android:cursorVisible="false"
        android:hint="@string/search_conversations_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="44dp"
        android:padding="10dp"
        android:textColor="@color/ink_black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/empty_conversations"
        android:textColor="@color/ink_black"
        android:textSize="18sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider_line"
            android:orientation="vertical"
            android:showDividers="middle|end" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/paginationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPrevPage"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/page_prev" />

        <TextView
            android:id="@+id/lblPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/ink_black"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnNextPage"
            style="@style/Widget.InkChat.Button.Flat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/page_next" />
    </LinearLayout>
</LinearLayout>
