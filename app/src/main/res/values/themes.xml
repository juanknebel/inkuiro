<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Windows with no animation at all: critical for e-ink -->
    <style name="NoWindowAnimations">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
    </style>

    <style name="Theme.InkChat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/ink_white</item>
        <item name="android:textColorPrimary">@color/ink_black</item>
        <item name="android:textColorSecondary">@color/ink_black</item>
        <item name="android:textColorHint">@color/ink_black</item>
        <item name="colorPrimary">@color/ink_black</item>
        <item name="colorPrimaryDark">@color/ink_black</item>
        <item name="colorAccent">@color/ink_black</item>

        <!-- No animations or transitions -->
        <item name="android:windowAnimationStyle">@style/NoWindowAnimations</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowDisablePreview">true</item>

        <!-- Kill ripple/highlight: on e-ink it shows as a gray flash -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="colorControlHighlight">@android:color/transparent</item>

        <!-- No shadows/elevation -->
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:spotShadowAlpha">0</item>

        <item name="android:textSize">18sp</item>
    </style>

    <!-- E-ink dialog: no animation, no dim, black border -->
    <style name="Theme.InkChat.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@drawable/bg_banner</item>
        <item name="android:textColorPrimary">@color/ink_black</item>
        <item name="android:textColorSecondary">@color/ink_black</item>
        <item name="colorAccent">@color/ink_black</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
    </style>

    <!-- Field label in forms -->
    <style name="Widget.InkChat.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- E-ink button: thick border, no ripple, no elevation -->
    <style name="Widget.InkChat.Button" parent="">
        <item name="android:background">@drawable/bg_button_border</item>
        <item name="android:textColor">@color/ink_black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Flat button for navigation glyphs (‹ ▲ ▼): no border, inversion when pressed -->
    <style name="Widget.InkChat.Button.Flat">
        <item name="android:background">@drawable/bg_button_flat</item>
        <item name="android:textColor">@color/flat_button_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
</resources>
